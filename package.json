{
  "name": "mechwiki",
  "version": "1.0.0",
  "description": "Mechanical Engineering Knowledge Hub",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000 --host 0.0.0.0",
    "build": "tsc && vite build",
    "lint": "tsc --noEmit",
    "preview": "vite preview --port 3000",
    "build:search": "node scripts/build-search-index.js",
    "validate": "node scripts/validate-topics.js",
    "new-topic": "node scripts/new-topic.js",
    "build:seo": "node scripts/generate-sitemap.js"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "katex": "^0.18.9",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}